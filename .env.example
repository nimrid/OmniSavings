# Privy (wallet auth). App ID is public; get it from the Privy Dashboard.
# Enable wallet authentication under Authentication > Login methods.
NEXT_PUBLIC_PRIVY_APP_ID=
NEXT_PUBLIC_PRIVY_CLIENT_ID=

# Aurora Intents Deposits API key (safe in public frontends per Intents docs).
# Used server-side here. Generate in Intents Studio.
INTENTS_API_KEY=

# Lulo API key (required for live Lulo quotes). Get one at https://dev.lulo.fi.
# Without it, Lulo quotes are reported as unavailable.
LULO_API_KEY=

# Jupiter API key (optional). Reads work keyless; a key raises rate limits.
JUPITER_API_KEY=

# Solana RPC URL (reserved for future on-chain reads; unused by current adapters).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
